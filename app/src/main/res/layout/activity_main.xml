<?xml version="1.0" encoding="utf-8"?>
<!--
  phone-eye's one screen. Deliberately plain: the human needs, in order,
  START/STOP, the two lines for the agent, the setup checklist, and the log.
  Everything an agent does appears in that log — the phone is never quietly driven.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An eye and a hand on this phone, for the agent you invite. Nothing runs until you tap Start. Stop is the off switch."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Stopped"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:text="▶  START phone-eye"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Give these two lines to the agent (and PHONE-EYE.md):"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/urlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E9E4D8"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="URL:   (press Start)"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tokenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E9E4D8"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="TOKEN: (press Start)"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/copyBothButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Copy URL + TOKEN for the agent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/copyUrlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy URL only" />
            <Button
                android:id="@+id/copyTokenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Copy TOKEN only" />
        </LinearLayout>

        <TextView
            android:id="@+id/tunnelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tunnel: —"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/localText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="LAN: —"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="The TOKEN is the ONLY lock on this door. Paste it only into the chat that owns the session — never into a group, a screenshot, or a commit. It changes every time you press Start."
            android:textSize="12sp" />

        <Switch
            android:id="@+id/readonlySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="Read-only mode (agent can look, never touch)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="One-time setup (each item is reported honestly in /selftest):"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="1. Accessibility (tap/swipe/screenshots): ?" />
        <Button
            android:id="@+id/accButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Accessibility settings → Installed apps → phone-eye: ON" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. Permissions (camera / location / media / contacts…): ?" />
        <Button
            android:id="@+id/permButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant permissions (deny any you don't want the agent to use)" />

        <TextView
            android:id="@+id/filesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="3. All-files access (agent file tools beyond media): ?" />
        <Button
            android:id="@+id/filesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open All-files access setting" />

        <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="4. Battery: allow running in background: ?" />
        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow background battery use" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Live log — every agent action lands here and in phoneeye.log:"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#141414"
            android:fontFamily="monospace"
            android:maxLines="40"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:text=""
            android:textColor="#C8E6C9"
            android:textSize="11sp" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear on-screen log (file log keeps everything)" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="phone-eye"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
